@echo off
setlocal
title BlissScape Client Launcher

set "JAVA_HOME=C:\Program Files\Java\latest\jre-1.8"
set "PATH=%JAVA_HOME%\bin;%PATH%"
set "JAVA_TOOL_OPTIONS=%JAVA_TOOL_OPTIONS% -XX:MaxRAMPercentage=50.0"

if not exist "%JAVA_HOME%\bin\java.exe" (
    echo JRE 8 not found at "%JAVA_HOME%"
    choice /c YN /n /m "Download and install 64-bit Java 8 now? Hit the Y-key for 'Yes' or the N-key for 'No' and to exit."

    if errorlevel 2 exit /b 1
    if not errorlevel 1 exit /b 1

    powershell.exe -NoLogo -NoProfile -Command ^
        "$ErrorActionPreference = 'Stop';" ^
        "$ProgressPreference = 'SilentlyContinue';" ^
        "$installer = Join-Path $env:TEMP ('BlissScape-JRE8-' + [guid]::NewGuid().ToString('N') + '.exe');" ^
        "try {" ^
        "  [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12;" ^
        "  Write-Host 'Downloading Java 8...';" ^
        "  Invoke-WebRequest -UseBasicParsing -Uri 'https://javadl.oracle.com/webapps/download/AutoDL?BundleId=254080_ee9438f370f14316bf0d13e23c26582b' -OutFile $installer;" ^
        "  if ((Get-AuthenticodeSignature -LiteralPath $installer).Status -ne 'Valid') { throw 'The downloaded installer does not have a valid signature.' };" ^
        "  Write-Host 'Complete the Java setup window to continue.';" ^
        "  $setup = Start-Process -FilePath $installer -ArgumentList 'REBOOT=0' -Verb RunAs -Wait -PassThru;" ^
        "  if ($setup.ExitCode -notin @(0, 3010)) { throw ('Installer exit code: ' + $setup.ExitCode) };" ^
        "} catch {" ^
        "  Write-Host ('Java setup failed: ' + $_.Exception.Message) -ForegroundColor Red; exit 1;" ^
        "} finally {" ^
        "  Remove-Item -LiteralPath $installer -Force -ErrorAction SilentlyContinue;" ^
        "}; exit 0"

    if errorlevel 1 (
        echo Java download or setup did not complete.
        pause
        exit /b 1
    )

    if not exist "%JAVA_HOME%\bin\java.exe" (
        echo Java was not found at "%JAVA_HOME%" after setup.
        echo Finish installing Java 8, then restart this script.
        pause
        exit /b 1
    )

    echo Java 8 found. Continuing...
)
)

cd /d "%~dp0"

powershell.exe -NoExit -NoLogo -NoProfile -Command "& { Write-Host ('[{0:yyyy-MM-dd HH:mm:ss.fff}] Starting launcher...' -f (Get-Date)); Write-Host ('[{0:yyyy-MM-dd HH:mm:ss.fff}] Closing this window will close the launcher, but not your game client.' -f (Get-Date)); Write-Host ('[{0:yyyy-MM-dd HH:mm:ss.fff}] If any errors occur, they will appear below.' -f (Get-Date)); & (Join-Path $env:JAVA_HOME 'bin\java.exe') '-jar' '.\BlissScape Launcher.jar' 2>&1 | ForEach-Object { '[{0:yyyy-MM-dd HH:mm:ss.fff}] {1}' -f (Get-Date), $_ };  $code = $LASTEXITCODE; Write-Host ('[{0:yyyy-MM-dd HH:mm:ss.fff}] Launcher exited with code {1}' -f (Get-Date), $code) }"

endlocal
